{
  "name": "@worm/mobile",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "portless \"$(../../scripts/portless-app-name.sh mobile.worm)\" --lan node ../../scripts/expo-portless-bridge.mjs expo start",
    "dev:android": "portless \"$(../../scripts/portless-app-name.sh mobile.worm)\" --lan node ../../scripts/expo-portless-bridge.mjs expo start --android",
    "dev:ios": "portless \"$(../../scripts/portless-app-name.sh mobile.worm)\" --lan node ../../scripts/expo-portless-bridge.mjs expo start --ios",
    "android": "pnpm run dev:android",
    "ios": "pnpm run dev:ios",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.16",
    "@expo/ui": "~56.0.21",
    "@worm/ebook-core": "workspace:*",
    "expo": "~56.0.15",
    "expo-build-properties": "~56.0.22",
    "expo-constants": "~56.0.20",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.22",
    "expo-file-system": "~56.0.8",
    "expo-haptics": "~56.0.3",
    "expo-linking": "~56.0.15",
    "expo-router": "~56.2.14",
    "expo-sharing": "~56.0.21",
    "expo-splash-screen": "~56.0.12",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-native": "catalog:react19",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "~0.8.3",
    "tailwindcss": "catalog:",
    "uniwind": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@worm/eslint-config": "workspace:*",
    "@worm/prettier-config": "workspace:*",
    "@worm/tailwind-config": "workspace:*",
    "@worm/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.0.17"
  },
  "prettier": "@worm/prettier-config"
}
