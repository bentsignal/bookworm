+- (void)forwardCustomMenuInvocation:(NSInvocation *)invocation
+{
+  NSString *selectorName = NSStringFromSelector([invocation selector]);
+  NSRange match = [selectorName rangeOfString:CUSTOM_SELECTOR];
+  if (match.location != 0) {
+    return;
+  }
+  RNCWebViewImpl *container = (RNCWebViewImpl *)self.superview;
+  [container tappedMenuItem:[selectorName substringFromIndex:CUSTOM_SELECTOR.length]];
+}
+- (void)forwardInvocation:(NSInvocation *)invocation
+{
+  NSString *selectorName = NSStringFromSelector([invocation selector]);
+  if ([selectorName rangeOfString:CUSTOM_SELECTOR].location == 0) {
+    [self forwardCustomMenuInvocation:invocation];
+    return;
+  }
+  [super forwardInvocation:invocation];
 }
