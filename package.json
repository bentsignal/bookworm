{
  "name": "worm",
  "description": "A calm, local-first workshop for your ebook library.",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": "^9.15.4"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "patchedDependencies": {
      "expo-modules-jsi@56.0.12": "patches/expo-modules-jsi@56.0.12.patch"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "portless proxy start --lan && turbo run dev --parallel --continue",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "ios": "pnpm --filter @worm/mobile ios",
    "android": "pnpm --filter @worm/mobile android"
  },
  "devDependencies": {
    "@worm/prettier-config": "workspace:*",
    "portless": "catalog:",
    "prettier": "catalog:",
    "turbo": "^2.5.8",
    "typescript": "catalog:"
  },
  "prettier": "@worm/prettier-config"
}
