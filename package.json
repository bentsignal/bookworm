{
  "name": "lib",
  "description": "A calm, local-first workshop for your ebook library.",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": "^9.15.4"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "patchedDependencies": {
      "react-native-webview@13.16.1": "patches/react-native-webview@13.16.1.patch",
      "react-native-screens@4.26.2": "patches/react-native-screens@4.26.2.patch"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "portless proxy start --lan && turbo run dev --parallel --continue",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "ios": "pnpm --filter @lib/mobile ios",
    "android": "pnpm --filter @lib/mobile android"
  },
  "devDependencies": {
    "@lib/prettier-config": "workspace:*",
    "portless": "catalog:",
    "prettier": "catalog:",
    "turbo": "^2.5.8",
    "typescript": "catalog:"
  },
  "prettier": "@lib/prettier-config"
}
